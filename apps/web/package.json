{
  "name": "@empirica/web",
  "version": "0.6.0",
  "private": true,
  "description": "Frontend del portal: React + Vite, local-first (IndexedDB) y PWA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "preview": "vite preview",
    "preview:mock": "vite preview --mode mock --outDir dist-mock",
    "typecheck": "tsc -p tsconfig.json && tsc -p mock/tsconfig.json && tsc -p integration/tsconfig.json && tsc -p sw/tsconfig.json && tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@empirica/shared": "*",
    "@firebase/app": "^0.16.2",
    "@firebase/auth": "^1.13.6",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "i18next": "^26.4.2",
    "pdfmake": "^0.3.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
