{
  "name": "@empirica/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend del portal: Google Apps Script escrito en TypeScript, empaquetado con esbuild y desplegado con clasp.",
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "push": "npm run build && clasp push --force"
  },
  "dependencies": {
    "@empirica/shared": "*"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13",
    "esbuild": "^0.28.2"
  }
}
